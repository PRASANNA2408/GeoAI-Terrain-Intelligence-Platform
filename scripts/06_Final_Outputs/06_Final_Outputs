  min: 1,
  max: 5,
  palette: [
    '006400',   // Class 1 - Very Low
    '7FFF00',   // Class 2 - Low
    'FFFF00',   // Class 3 - Moderate
    'FFA500',   // Class 4 - High
    'FF0000'    // Class 5 - Very High
