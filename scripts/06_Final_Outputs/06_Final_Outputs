// ------------------------------------------------------------
// ADD CLASS NAMES
// ------------------------------------------------------------

var finalSummaryTable = classAreaPercentage.map(function(feature) {

  var classNumber = ee.Number(feature.get('class'));

  var className = ee.Algorithms.If(
    classNumber.eq(1), 'Very Low',
    ee.Algorithms.If(
      classNumber.eq(2), 'Low',
      ee.Algorithms.If(
        classNumber.eq(3), 'Moderate',
        ee.Algorithms.If(
          classNumber.eq(4), 'High',
          'Very High'
        )
      )
    )
  );

  return feature.set({
    'class_name': className
  });
});

// ------------------------------------------------------------
// SELECT FINAL TABLE COLUMNS
// ------------------------------------------------------------

finalSummaryTable = finalSummaryTable.select([
  'class',
  'class_name',
  'area_km2',
  'percentage'
]);

