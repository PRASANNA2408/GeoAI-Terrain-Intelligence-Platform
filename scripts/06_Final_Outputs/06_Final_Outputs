// CALCULATE STUDY AREA
// ------------------------------------------------------------

var finalAreaKm2 = finalStudyArea
  .area({
    maxError: 100
  })
  .divide(1e6);

print(
  'Final Study Area Area (km²):',
  finalAreaKm2
);

