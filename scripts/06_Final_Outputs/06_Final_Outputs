// ============================================================
// STEP 30: SUSCEPTIBILITY CLASS AREA & PERCENTAGE
// ============================================================

print('==============================================');
print('STEP 30: SUSCEPTIBILITY CLASS AREA ANALYSIS');
print('==============================================');

// ------------------------------------------------------------
// CALCULATE PIXEL AREA
// ------------------------------------------------------------

var pixelArea = ee.Image.pixelArea();

// ------------------------------------------------------------
// CALCULATE AREA FOR EACH CLASS
// ------------------------------------------------------------

var classAreas = ee.List.sequence(1, 5).map(function(classValue) {

  var classMask = susceptibilityClass.eq(ee.Number(classValue));

  var area = pixelArea
    .updateMask(classMask)
    .reduceRegion({
      reducer: ee.Reducer.sum(),
      geometry: studyArea,
      scale: 30,
      maxPixels: 1e13
    })
    .get('area');

  return ee.Feature(null, {
    'class': classValue,
    'area_km2': ee.Number(area).divide(1e6)
  });
});

// ------------------------------------------------------------
// CREATE FEATURE COLLECTION
// ------------------------------------------------------------

var classAreaFC = ee.FeatureCollection(classAreas);

// ------------------------------------------------------------
// TOTAL AREA
// ------------------------------------------------------------

var totalClassArea = classAreaFC.aggregate_sum('area_km2');

// ------------------------------------------------------------
// ADD PERCENTAGE
// ------------------------------------------------------------

var classAreaPercentage = classAreaFC.map(function(feature) {

  var percentage = ee.Number(feature.get('area_km2'))
    .divide(totalClassArea)
    .multiply(100);

  return feature.set('percentage', percentage);
});

// ------------------------------------------------------------
// PRINT RESULTS
// ------------------------------------------------------------

print('Susceptibility Class Area & Percentage:',
      classAreaPercentage);

print('Total Classified Area (km²):',
      totalClassArea);

// ------------------------------------------------------------
// CLASS-WISE RESULTS
// ------------------------------------------------------------

print('Class 1 - Very Low:',
      classAreaPercentage.filter(
        ee.Filter.eq('class', 1)));

print('Class 2 - Low:',
      classAreaPercentage.filter(
        ee.Filter.eq('class', 2)));

print('Class 3 - Moderate:',
      classAreaPercentage.filter(
        ee.Filter.eq('class', 3)));

print('Class 4 - High:',
      classAreaPercentage.filter(
        ee.Filter.eq('class', 4)));

print('Class 5 - Very High:',
      classAreaPercentage.filter(
        ee.Filter.eq('class', 5)));

